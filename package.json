{
  "name": "@orzroa/vue-beautiful-chat",
  "version": "3.0.0",
  "description": "A simple and beautiful Vue chat component backend agnostic.",
  "main": "./dist/vue-beautiful-chat.umd.js",
  "module": "./dist/vue-beautiful-chat.es.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzroa/vue-beautiful-chat.git"
  },
  "author": "orzroa <orzroa@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "build:vue-cli": "vue-cli-service build --target lib --name vue-beautiful-chat --formats umd-min src/index.js",
    "lint": "vue-cli-service lint",
    "watch": "vite build --watch",
    "dev": "vite",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/*"
  ],
  "dependencies": {
    "autolinker": "^1.8.3",
    "emoji-js": "^3.4.0",
    "escape-goat": "^1.3.0",
    "floating-vue": "^2.0.0",
    "imagemin": "^6.1.0",
    "kind-of": "6.0.3",
    "minimist": "1.2.3",
    "mitt": "^3.0.0",
    "msgdown": "^1.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.27.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.1.0",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "node-forge": "^1.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.75.0",
    "sass-loader": "^14.0.0",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue": "^3.2.0"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "keywords": [
    "vue",
    "vuejs",
    "chat",
    "vue-js-chat"
  ],
  "bugs": {
    "url": "https://github.com/orzroa/vue-beautiful-chat/issues"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,vue}": "vue-cli-service lint"
  },
  "homepage": "https://github.com/orzroa/vue-beautiful-chat#readme"
}
